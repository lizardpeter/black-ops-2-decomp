; runtime/loader/kernel32.def: what the loader imports
LIBRARY kernel32.dll
EXPORTS
LoadLibraryW
GetProcAddress
GetModuleHandleW
GetModuleFileNameW
GetSystemDirectoryW
VirtualProtect
GetCurrentProcess
TerminateProcess
OutputDebugStringA
FlushInstructionCache
DisableThreadLibraryCalls
CreateFileW
WriteFile
CloseHandle
